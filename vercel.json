{
  "redirects": [
    {
      "source": "/boss-hours",
      "destination": "/the-endgame-is-me/",
      "permanent": true
    },
    {
      "source": "/boss-hours/(.*)",
      "destination": "/the-endgame-is-me/$1",
      "permanent": true
    },
    {
      "source": "/v/boss-hours/(.*)",
      "destination": "/v/the-endgame-is-me/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v/:slug/:n/",
      "destination": "/:slug/"
    },
    {
      "source": "/v/:slug/:n/:path*",
      "destination": "/:slug/:path*"
    }
  ]
}
