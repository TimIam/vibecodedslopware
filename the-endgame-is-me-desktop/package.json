{
  "name": "the-endgame-is-me",
  "productName": "The Endgame is Me",
  "version": "1.0.0",
  "private": true,
  "description": "A reverse boss fight: you are the raid boss.",
  "author": "Vibe Coded Slopware",
  "license": "UNLICENSED",
  "main": "app/main.cjs",
  "scripts": {
    "stage": "node stage.mjs",
    "start": "node stage.mjs && electron .",
    "build:win": "node stage.mjs && electron-builder --win --x64 --dir",
    "build:linux": "node stage.mjs && electron-builder --linux --x64 --dir",
    "build:mac": "node stage.mjs && electron-builder --mac --universal --dir"
  },
  "devDependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.vibecodedslopware.endgameisme",
    "productName": "The Endgame is Me",
    "executableName": "TheEndgameIsMe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": "dir",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "TheEndgameIsMe"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false
    }
  }
}
